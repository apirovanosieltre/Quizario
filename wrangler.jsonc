{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quizario",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./dist/quizario/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quizario-db",
      "database_id": "7cdc2fc4-4455-482e-b5de-f0365fa3d6e1",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "10 3 * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE",
      "namespace_id": "23001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "QUIZ_RATE",
      "namespace_id": "23002",
      "simple": {
        "limit": 90,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "quizario.cicioweb.app",
      "custom_domain": true
    }
  ]
}
