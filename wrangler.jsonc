{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quizario",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./dist/quizario/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quizario-db",
      "database_id": "7cdc2fc4-4455-482e-b5de-f0365fa3d6e1",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "10 3 * * *"
    ]
  }
}
